{
  "name": "@cicuci/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/server.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "node --env-file=../../.env scripts/deploy.mjs",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "test:integration": "RUN_DB_TESTS=1 tsx --env-file=../../.env --test test/workflows.test.ts"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "~6.19.0",
    "tsx": "^4.19.0"
  }
}
