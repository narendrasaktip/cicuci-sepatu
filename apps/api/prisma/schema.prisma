model RatePlan {
  archivedAt DateTime? @db.DateTime(3)
  id       String  @id @default(cuid()) @db.VarChar(30)
  name     String  @unique @db.VarChar(100)
  isActive Boolean @default(true)
  revision Int     @default(1)
  rules    Json
  turnaroundPolicy String @default("REGULAR") @db.VarChar(10)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum DeliveryStatus {
  SIMULATED
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  archivedAt DateTime? @db.DateTime(3)
  id           String    @id @default(cuid()) @db.VarChar(30)
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(100)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  sessions     Session[]
}

model Session {
  tokenHash String   @id @db.Char(64)
  csrfToken String   @db.Char(64)
  userId    String   @db.VarChar(30)
  expiresAt DateTime @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  entityType  String? @db.VarChar(100)
  metadata    Json?
  id          String   @id @default(cuid()) @db.VarChar(30)
  actorUserId String?  @db.VarChar(30)
  action      String   @db.VarChar(100)
  entityId    String?  @db.VarChar(191)
  occurredAt  DateTime @default(now()) @db.DateTime(3)

  @@index([actorUserId, occurredAt])
}

model NotificationEvent {
  encryptedMessage String? @db.Text
  id             String                @id @default(cuid()) @db.VarChar(30)
  orderId        String?               @db.VarChar(30)
  order          Order?                @relation(fields: [orderId], references: [id])
  itemId         String?               @db.VarChar(30)
  expectedStatus String?               @db.VarChar(30)
  provider       String                @default("whatsapp-web.js") @db.VarChar(30)
  activation     String?               @db.VarChar(36)
  generation     Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @db.DateTime(3)
  eventKey       String                @unique @db.VarChar(191)
  recipient      String                @db.VarChar(20)
  template       String                @db.VarChar(100)
  message        String                @db.Text
  optedIn        Boolean
  status         DeliveryStatus        @default(PENDING)
  attempts       NotificationAttempt[]
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)

  @@index([status, createdAt])
}

model NotificationAttempt {
  id          String            @id @default(cuid()) @db.VarChar(30)
  eventId     String            @db.VarChar(30)
  attemptNo   Int
  provider    String            @db.VarChar(30)
  status      DeliveryStatus
  response    Json
  attemptedAt DateTime          @default(now()) @db.DateTime(3)
  event       NotificationEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, attemptNo])
}

enum ItemStatus {
  RECEIVED
  INSPECTION
  AWAITING_CONSENT
  QUEUED
  WASHING
  DRYING
  PACKING
  FINISHING
  QC
  REWORK
  READY_FOR_PICKUP
  HANDED_OVER
  RETURN_PENDING
  RETURNED
}

model Customer {
  salutation String @default("Kak") @db.VarChar(3)
  archivedAt DateTime? @db.DateTime(3)
  id                    String    @id @default(cuid()) @db.VarChar(30)
  name                  String    @db.VarChar(100)
  whatsapp              String    @db.VarChar(20)
  notes                 String?   @db.Text
  notificationConsentAt DateTime? @db.DateTime(3)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  orders                Order[]

  @@index([whatsapp])
}

model Service {
  id           String      @id @default(cuid()) @db.VarChar(30)
  name         String      @db.VarChar(100)
  basePriceIdr Int
  isActive     Boolean     @default(true)
  items        OrderItem[]
}

model StoreSettings {
  displaySettings    Json?
  waTemplates        Json?
  waActivation       String? @db.VarChar(36)
  id                 Int    @id @default(1)
  name               String @default("Cicuci Sepatu") @db.VarChar(100)
  pickupInstructions String @default("") @db.Text
  consentHours       Int    @default(48)
}

model Order {
  archivedAt DateTime? @db.DateTime(3)
  pricing               Json?
  id                    String              @id @default(cuid()) @db.VarChar(30)
  number                String              @unique @db.VarChar(50)
  customerId            String              @db.VarChar(30)
  customer              Customer            @relation(fields: [customerId], references: [id])
  estimatedCompletionAt DateTime            @db.DateTime(3)
  pickupInstructions    String              @db.Text
  aggregateStatus       String              @default("RECEIVED") @db.VarChar(30)
  trackingSecret        String?             @db.Text
  trackingHash          String?             @unique @db.Char(64)
  createdAt             DateTime            @default(now()) @db.DateTime(3)
  items                 OrderItem[]
  payments              Payment[]
  notifications         NotificationEvent[]

  @@index([aggregateStatus, createdAt])
}

model OrderItem {
  id             String            @id @default(cuid()) @db.VarChar(30)
  orderId        String            @db.VarChar(30)
  order          Order             @relation(fields: [orderId], references: [id])
  serviceId      String            @db.VarChar(30)
  service        Service           @relation(fields: [serviceId], references: [id])
  serviceName    String            @db.VarChar(100)
  brand          String            @db.VarChar(100)
  model          String            @db.VarChar(100)
  color          String            @db.VarChar(100)
  initialNotes   String            @db.Text
  assignedUserId String?           @db.VarChar(30)
  status         ItemStatus        @default(RECEIVED)
  quotedPriceIdr Int
  finalPriceIdr  Int               @default(0)
  outcome        String?           @db.VarChar(30)
  qcPassed       Boolean           @default(false)
  inspection     Inspection?
  consents       ConsentDecision[]
  history        StatusHistory[]
  photos         Photo[]

  @@index([orderId])
  @@index([assignedUserId, status])
}

model Inspection {
  id             String    @id @default(cuid()) @db.VarChar(30)
  itemId         String    @unique @db.VarChar(30)
  item           OrderItem @relation(fields: [itemId], references: [id])
  outcome        String    @db.VarChar(30)
  notes          String    @db.Text
  findings       String?   @db.Text
  customerNote   String?   @db.Text
  risk           String    @db.Text
  quotedPriceIdr Int
  actorUserId    String    @db.VarChar(30)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
}

model ConsentDecision {
  id             String    @id @default(cuid()) @db.VarChar(30)
  itemId         String    @db.VarChar(30)
  item           OrderItem @relation(fields: [itemId], references: [id])
  tokenHash      String    @unique @db.Char(64)
  findings       String?   @db.Text
  customerNote   String?   @db.Text
  risk           String    @db.Text
  quotedPriceIdr Int
  expiresAt      DateTime  @db.DateTime(3)
  consumedAt     DateTime? @db.DateTime(3)
  decision       String?   @db.VarChar(30)
  createdAt      DateTime  @default(now()) @db.DateTime(3)

  @@index([itemId])
}

model StatusHistory {
  id          String    @id @default(cuid()) @db.VarChar(30)
  itemId      String    @db.VarChar(30)
  item        OrderItem @relation(fields: [itemId], references: [id])
  fromStatus  String?   @db.VarChar(30)
  toStatus    String    @db.VarChar(30)
  actorUserId String?   @db.VarChar(30)
  reason      String    @db.Text
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  @@index([itemId, createdAt])
}

model Photo {
  id              String    @id @default(cuid()) @db.VarChar(30)
  itemId          String    @db.VarChar(30)
  item            OrderItem @relation(fields: [itemId], references: [id])
  kind            String    @db.VarChar(20)
  customerVisible Boolean
  mime            String    @db.VarChar(30)
  content         Bytes     @db.MediumBlob
  createdAt       DateTime  @default(now()) @db.DateTime(3)

  @@index([itemId])
}

model Payment {
  id          String   @id @default(cuid()) @db.VarChar(30)
  orderId     String?  @db.VarChar(30)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  originalOrderId     String @db.VarChar(30)
  originalOrderNumber String @db.VarChar(50)
  kind        String   @db.VarChar(10)
  amountIdr   Int
  method      String   @db.VarChar(20)
  reference   String?  @db.VarChar(191)
  reason      String   @db.Text
  actorUserId String   @db.VarChar(30)
  receivedAt  DateTime @db.DateTime(3)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([orderId])
}

model Idempotency {
  id          String   @id @db.Char(64)
  fingerprint String   @db.Char(64)
  response    Json
  createdAt   DateTime @default(now()) @db.DateTime(3)
}
