WA_CHROME_PATH=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner
MYSQL_DATABASE=cicuci_sepatu_dev
MYSQL_USER=cicuci
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

# Private 32-byte hex secret shared by API/worker; never print or commit a real value.
WA_MESSAGE_KEY=
