NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://cicuci:change-me@127.0.0.1:3306/cicuci_sepatu_dev
REDIS_URL=redis://127.0.0.1:6379
APP_BASE_URL=http://127.0.0.1:5173
UPLOAD_ROOT=../../var/uploads
# Pairing alone never enables sends. Node >=22.12 required for patched Chromium adapter.
